GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json
PROJECT_ID="lab16507702-1788328422"
LOCATION=us-central1

# ========================================
# MODEL CONFIGURATION
# ========================================

# Gemini model to use (default: gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash

# ========================================
# RESEARCH SETTINGS
# ========================================

# Maximum iterations for research refinement loop (Lesson 4 - LoopAgent)
MAX_ITERATIONS=3

# Quality threshold for accepting research answers (0.0-1.0)
QUALITY_THRESHOLD=0.8
RESEARCH_QUERY="which plays have been performed this in 2026 in the Staatstheater Nürnberg"

# ========================================
# CUSTOM RESEARCH QUERY (Optional)
# ========================================

# Set a custom research query (overrides default queries in main.py)
# RESEARCH_QUERY=What are the latest advances in quantum computing?

